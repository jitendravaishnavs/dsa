    "# n=1234\n",
    "n=1234321\n",
    "num=n\n",
    "result=0\n",
    "# numm =n\n",
    "\n",
    "while num>0:\n",
    "    last_digit = num%10\n",
    "    result =(result*10)+last_digit\n",
    "    num =num//10\n",
    "    \n",
    "result\n",
    "\n",
    "result==n"
   ]
