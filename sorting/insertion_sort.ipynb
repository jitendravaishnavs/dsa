   "source": [
    "nums=[3,5,6,4,8,9,10,7,1]\n",
    "\n",
    "def insertion_sort(nums):\n",
    "    n= len(nums)\n",
    "    for i in range(1,n):\n",
    "        key =nums[i]\n",
    "        j = i-1\n",
    "        while j>=0 and nums[j]>key:\n",
    "            nums[j+1]=nums[j]\n",
    "            j-=1\n",
    "        nums[j+1]=key\n",
    "    print(nums)\n",
    "        \n",
    "insertion_sort(nums)"
   ]
  },
