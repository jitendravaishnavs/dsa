   "source": [
    "n = [ 5,7,3, 2,6,1,5,9]\n",
    "def reverse_array(nums):\n",
    "    left, right = 0, len(nums) - 1\n",
    "    \n",
    "    while left < right:\n",
    "        nums[left], nums[right] = nums[right], nums[left]\n",
    "        left += 1\n",
    "        right -= 1\n",
    "\n",
    "    return nums\n",
    "\n",
    "\n",
    "reverse_array(n)"
   ]
  },
