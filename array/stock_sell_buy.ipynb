   "source": [
    "prices = [7,2,1,5,6,4,8]\n",
    "\n",
    "mp=0\n",
    "min_price=prices[0]\n",
    "n = len(prices)\n",
    "for i in range(0,n):\n",
    "    profit = prices[i] - min_price\n",
    "    min_price = min(min_price,profit)\n",
    "    mp = max(mp,prices[i]-profit)\n",
    "mp"
   ]
