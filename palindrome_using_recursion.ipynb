   ],
   "source": [
    "s=\"abcddcba\"\n",
    "\n",
    "def rev(s,l,r):\n",
    "    if l>=r :\n",
    "        return True\n",
    "    if s[l]!=s[r]:\n",
    "        return False\n",
    "    return rev(s,l+1,r-1)\n",
    "\n",
    "\n",
    "print('Palindrome' if rev(s, 0, len(s)-1) else 'Not Palindrome')"
   ]
  },
