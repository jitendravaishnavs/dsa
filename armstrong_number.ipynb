    "# n=152\n",
    "num=n\n",
    "result =0\n",
    "nod= len(str(n))\n",
    "while num>0:\n",
    "    last_digits = num%10\n",
    "    \n",
    "    result += last_digits ** nod\n",
    "    num = num//10\n",
    "# result \n",
    "f\"{'This Is Armstrong Number'if result ==n else 'Not ArmStrong'}\"\n",
